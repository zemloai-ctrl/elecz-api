          "200": {
            "description": "Contract comparison response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "signal": {
                      "type": "string",
                      "example": "elecz_contract"
                    },
                    "zone": {
                      "type": "string"
                    },
                    "currency": {
